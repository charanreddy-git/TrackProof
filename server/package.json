  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
