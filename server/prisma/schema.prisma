generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")

}

enum Role {
  USER
  CAPTAIN
}

enum TaskStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

model User {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  phoneVerifiedAt DateTime?
  // Optional for receipts/report delivery. Auth is phone-first, no password.
  email           String?   @unique
  role            Role

  createdTasks  Task[] @relation("CreatedTasks")
  acceptedTasks Task[] @relation("AcceptedTasks")

  captainProfile   CaptainProfile?
  requesterProfile RequesterProfile?

  createdAt DateTime @default(now())
}

model PhoneOtp {
  id              String   @id @default(cuid())
  phone           String   @unique
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  sendCount       Int      @default(1)
  windowStartedAt DateTime @default(now())
  lastSentAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model CaptainProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRadius     Float    @default(5.0)
  verificationCount Int      @default(0)
  completionRate    Float    @default(100.0)
  earningsTotal     Float    @default(0.0)
  averageRating     Float    @default(5.0)
}

model RequesterProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String?
  totalRequests    Int     @default(0)
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  targetLat   Float
  targetLng   Float
  status      TaskStatus @default(OPEN)

  evidenceImage       String?
  evidenceLat         Float?
  evidenceLng         Float?
  evidenceAccuracy    Float?
  evidenceCapturedAt  DateTime?
  evidenceSubmittedAt DateTime?

  createdById  String
  acceptedById String?

  createdBy  User  @relation("CreatedTasks", fields: [createdById], references: [id])
  acceptedBy User? @relation("AcceptedTasks", fields: [acceptedById], references: [id])

  locationLogs LocationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([acceptedById])
}

model LocationLog {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  taskId    String
  captainId String
  task      Task     @relation(fields: [taskId], references: [id])
  timestamp DateTime @default(now())

  @@index([taskId, timestamp])
}
