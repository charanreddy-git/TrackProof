# --- Server (.env in /server) ---

# Neon PostgreSQL (pooled — for application traffic)
DATABASE_URL="postgresql://neondb_owner:npg_wgM3qiIDOb1Z@ep-raspy-feather-aqrk05sn-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon PostgreSQL (direct — for migrations/CLI)
DIRECT_URL="postgresql://neondb_owner:npg_wgM3qiIDOb1Z@ep-raspy-feather-aqrk05sn-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
